<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TestWebshop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestWebshop.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
</head>


<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">VioletVideo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">
                
                        <!-- Home -->

                        <li class="nav-item">
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Home
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-orderBy="Home">Home</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Contact" asp-route-orderBy="Contact">Contact</a></li>
                                </ul>
                            </div>
                        </li>





                        <!-- Customer -->

                        <li class="nav-item">
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Customers
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index" asp-route-orderBy="Create">Create</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customers" asp-action="AllCustomers" asp-route-orderBy="AllCustomers">ListOfCustomers</a></li>
                                </ul>
                            </div>
                        </li>



                        <!-- Movie -->

                        <li class="nav-item">

                        <div class="dropdown">
                            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Movies
                            </button>
                            <ul class="dropdown-menu">
                                 
                                <li><a class="dropdown-item" asp-controller ="Movie" asp-action="LatestMovies" asp-route-orderBy="newest">NewMovies</a></li>
                                <li><a class="dropdown-item" asp-controller="Movie" asp-action="OldestMovies" asp-route-orderBy="oldest">OldestMovies</a></li>
                                <li><a class="dropdown-item" asp-controller="Movie" asp-action="PopularMovies" asp-route-orderBy="PopularMovies">PopularMovies</a></li>
                                <li><a class="dropdown-item" asp-controller="Movie" asp-action="CheapestMovies" asp-route-orderBy="CheapestMovies">CheapestMovies</a></li>
                             
                            </ul>
                        </div>
                   
                      </li>




                        <!-- order-->

                <li class="nav-item">
                    <div class="dropdown">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Orders
                        </button>
                        <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Orders" asp-action="DisplayOrders" asp-route-orderBy="Display">OrdersOfEachCustomer</a></li>
                        </ul>
                    </div>
                </div>
                </li>

                <!-- Shopping Cart -->
             

                        <li class="nav-item">
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Orders
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="DisplayOrders" asp-route-orderBy="Display">OrdersOfEachCustomer</a></li>
                                </ul>
                            </div>
                        </li>




                        <li class="nav-item">

                            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
                                ShoppingCart
                                <i class="bi bi-cart"></i>
                            </button>

                      </li>




                <!-- Search Form -->

                    @using (Html.BeginForm("Index", "Movie", FormMethod.Get, new { @class = "form-inline my-2 my-lg-0" }))

                    {
          
                        <div class="input-group">
                            <input class="form-control" type="search" placeholder="Search Movies" name="searchString" aria-label="Search">
                            <div class="input-group-append">
                                <button class="btn btn-outline-success" type="submit">Search</button>
                            </div>
                        </div>
                   
                    }


                <!-- Admin Dropdown -->


                <ul class="navbar-nav">

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown1" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Admin

                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown1">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown2" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                   
                                  Customer  

                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index" asp-route-orderBy="Create">Create</a></li>
                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index" asp-route-orderBy="Edit">Edit</a></li>
                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="AllCustomers" asp-route-orderBy="AllCustomers">ListOfCustomers</a></li>

                                </a>


                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown2">
                                    <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index" asp-route-orderBy="Create">Create</a></li>
                                   
                                </ul>
                  
                            </li>
                    <li>
                      <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown2" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Movies
                          
                    <li><a class="dropdown-item" asp-controller="Movie" asp-action="Create" asp-route-orderBy="Create">Create</a></li>
                    <li><a class="dropdown-item" asp-controller="Movie" asp-action="Index" asp-route-orderby="Edit">Edit</a></li>
                    <li><a class="dropdown-item" asp-controller="Movie" asp-action="Index" asp-route-orderBy="Details">Details</a></li>

                      </a>

                    </li>

                    <li>
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown2" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Orders

                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Create" asp-route-orderBy="Create">Create</a></li>
                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index" asp-route-orderBy="Edit">Edit</a></li>
                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index" asp-route-orderBy="Details">Details</a></li>

                    </a>

                    </li>         

                </ul>

                </div>
            </div>
        </nav>

    </header>

    <partial name="_OffcanvasCartPartial" />


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div id="content">
        @RenderBody()
    </div>



    <footer class="border-top footer text-muted">
        <div class="container">
            &copy;VioletVideo -  @DateTime.Now.Year <a asp-area="" asp-controller="Home" asp-action="Content">.Net Core MVC Project</a>

        </div>



    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
