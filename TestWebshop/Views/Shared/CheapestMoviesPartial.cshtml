@model List<TestWebshop.Models.Database.Movie>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].ReleaseYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].Price)
            </th>
            <th></th>
        </tr>
    </thead>


    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Title" asp-controller="Movie" asp-route-id="@item.Id">
                    <img src="@item.ImageURL" alt="Poster for the movie @item.Title" style="width: 50px">
                    </a>
                </td>
                <td>
                    <a asp-action="Title" asp-controller="Movie" asp-route-id="@item.Id">@item.Title</a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseYear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    <a asp-action="AddToCart" asp-controller="ShopingCart" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Buy</a>
                </td>
            </tr>
        }
    </tbody>
</table>


 
