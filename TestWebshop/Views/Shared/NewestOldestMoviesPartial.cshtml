@model List<TestWebshop.Models.Database.Movie>

@{
    string act = "Index";
    string ctrl = "Home";
}


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].ReleaseYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].Price)
            </th>
            <th></th>
        </tr>
    </thead>


    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-controller="Movie" asp-route-id="@item.Id">
                        <img src="@item.ImageURL" alt="Poster for the movie @item.Title" style="width: 50px">
                    </a>
                </td>
                <td>
                    <a asp-action="Details" asp-controller="Movie" asp-route-id="@item.Id" style="text-decoration:none">@item.Title</a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseYear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.Id" asp-route-act="@act" asp-route-ctrl="@ctrl" class="btn btn-sm btn-outline-primary">Buy</a>
                </td>
            </tr>
        }
    </tbody>
</table>






