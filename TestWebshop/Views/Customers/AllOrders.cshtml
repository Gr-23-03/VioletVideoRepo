@* @model IEnumerable<TestWebshop.Models.Database.Order> *@

@model IEnumerable<TestWebshop.Models.ViewModels.CustomerOrder>


  
@{
    ViewData["Title"] = "AllOrders";
}

<div class="container mt-5">
    <h1>Orders</h1>

    <h2>Welcome, @ViewData["Name"]!</h2>

    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th>Date</th>
                <th>Total</th>
                <th>Movies</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Date.ToShortDateString()</td>
                    <td>@order.Total.ToString("C")</td>
                    <td>
                        <ul class="list-group">
                            @foreach (var movie in order.Movies)
                            {
                                <li class="list-group-item">@movie.Title</li>
                                
                            }
                        </ul>
                    </td>

                    <td>
                        <ul class="list-group">
                            @foreach (var movie in order.Movies)
                            {
                                <li class="list-group-item">@movie.Price</li>

                            }
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>