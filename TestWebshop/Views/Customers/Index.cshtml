@* @model IEnumerable<TestWebshop.Models.Database.Customer> *@

@model TestWebshop.Models.CustomerViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

 <form asp-controller="Customers" asp-action="Index" method="get">
    <p>
        <input type="text" name="SearchString">
        <input type="submit" value="Search" />
    </p>
</form> 



 <table class="table">
    <thead>
        <tr>
            <th>
                model.movies[0].Title
                @Html.DisplayNameFor(model => model.customers[0].FirstName)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].LastName)
            </th>
            <th>
               
                @Html.DisplayNameFor(model => model.customers[0].BillingAddress)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].BillingCity)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].BillingZip)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].DeliveryAddress)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].DeliveryCity)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].DeliveryZip)
            </th>
            <th>
               
                @Html.DisplayNameFor(model => model.customers[0].EmailAddress)
            </th>
            <th>
                
                @Html.DisplayNameFor(model => model.customers[0].Phone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in @Model.customers) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BillingAddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BillingCity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BillingZip)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryAddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryCity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryZip)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmailAddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td> 
        </tr>
}
    </tbody>
</table>  



 <div class="container">
    @if (Model.pager.TotalPages > 0)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end">
                <li class="page-item @(Model.pager.CurrentPage == 1 ? "disabled" : "") @(Model.pager.CurrentPage == 1 ? "d-none" : "")">
                    <a class="page-link" asp-controller="Movie" asp-action="Index" asp-route-pg="1" aria-label="First">
                        <span aria-hidden="true">First</span>
                    </a>
                </li>
                <li class="page-item @(Model.pager.CurrentPage == 1 ? "disabled" : "") @(Model.pager.CurrentPage == 1 ? "d-none" : "")">
                    <a class="page-link" asp-controller="Movie" asp-action="Index" asp-route-pg="@(Model.pager.CurrentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">Previous</span>
                    </a>
                </li>
                @for (var pge = Model.pager.StartPage; pge <= Model.pager.EndPage; pge++)
                {
                    <li class="page-item @(pge == Model.pager.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-controller="Movie" asp-action="Index" asp-route-pg="@pge">@pge</a>
                    </li>
                }
                <li class="page-item @(Model.pager.CurrentPage == Model.pager.TotalPages ? "disabled" : "") @(Model.pager.CurrentPage == Model.pager.TotalPages ? "d-none" : "")">
                    <a class="page-link" asp-controller="Movie" asp-action="Index" asp-route-pg="@(Model.pager.CurrentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">Next</span>
                    </a>
                </li>
                <li class="page-item @(Model.pager.CurrentPage == Model.pager.TotalPages ? "disabled" : "") @(Model.pager.CurrentPage == Model.pager.TotalPages ? "d-none" : "")">
                    <a class="page-link" asp-controller="Movie" asp-action="Index" asp-route-pg="@Model.pager.TotalPages" aria-label="Last">
                        <span aria-hidden="true">Last</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
