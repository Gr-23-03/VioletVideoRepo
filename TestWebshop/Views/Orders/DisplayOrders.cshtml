@model List<IGrouping<int, TestWebshop.Models.Database.Order>>



@{
    ViewData["Title"] = "DisplayOrders";
}

<h2>Orders</h2>

@foreach (var customerGroup in Model)
{
    var customer = customerGroup.First().Customer;

    <div class="card mb-4">
        <div class="card-header">
            <h3 class="mb-0">Customer: @customer.FirstName</h3>
        </div>
        <div class="card-body">
            @foreach (var item in customerGroup)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <p class="mb-1">
                            <strong>Orders ID:</strong> @item.Id <br />
                            <strong>Customer ID:</strong> @item.CustomerId <br />
                            <strong>Amount:</strong> $@item.OrderPrice <br />
                            <strong>Orders Date:</strong> @item.OrderDate
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}