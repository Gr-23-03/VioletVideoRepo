@model IEnumerable<TestWebshop.Models.ViewModels.DisplayCartVM>


@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>




@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="cart-item">
            <p>@item.Title - Quantity: <span class="quantity">@item.Quantity</span></p>
            <img width="66" src="@item.PictureUrl">
            <p>Price: <span class="price">@item.Price kr</span></p>
            <p>Total: @item.TotalPrice</p>
        </div>
    }
}

