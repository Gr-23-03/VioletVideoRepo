@model TestWebshop.Models.Database.Customer

@{
    ViewData["Title"] = "CreateCustomer";
}

<h1>CreateCustomer</h1>

<form asp-controller="Cart" asp-action="CreateCustomer" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mt-3">
        <label asp-for="FirstName" class="control-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="LastName" class="control-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="BillingAddress" class="control-label"></label>
        <input asp-for="BillingAddress" class="form-control" />
        <span asp-validation-for="BillingAddress" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="BillingCity" class="control-label"></label>
        <input asp-for="BillingCity" class="form-control" />
        <span asp-validation-for="BillingCity" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="BillingZip" class="control-label"></label>
        <input asp-for="BillingZip" class="form-control" />
        <span asp-validation-for="BillingZip" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="DeliveryAddress" class="control-label"></label>
        <input asp-for="DeliveryAddress" class="form-control" />
        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="DeliveryCity" class="control-label"></label>
        <input asp-for="DeliveryCity" class="form-control" />
        <span asp-validation-for="DeliveryCity" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="DeliveryZip" class="control-label"></label>
        <input asp-for="DeliveryZip" class="form-control" />
        <span asp-validation-for="DeliveryZip" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="EmailAddress" class="control-label"></label>
        <input asp-for="EmailAddress" class="form-control" />
        <span asp-validation-for="EmailAddress" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Phone" class="control-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group mt-5 mb-3">
        <input type="submit" value="Create Customer and save order" class="btn btn-primary" />
    </div>
</form>

