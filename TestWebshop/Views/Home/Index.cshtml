@model TestWebshop.Models.ViewModels.HomeIndexVM
@{
    ViewData["Title"] = "Home Page";

   
}


    <h1 class="display-4">Welcome</h1>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous">


<div class="row">
    <div class="col-sm-4" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <h3 style="text-shadow: 5px 5px 10px red">Most popular Movies:</h3>
        <partial name="CarouselPartial" model="@Model.NewestMovies"></partial>   @* Most sold Movies in carousel (4 columns)*@
    </div>

    <div class="col-sm-8" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <h3 style="text-shadow: 5px 5px 10px red">Cheapest Movies:</h3>
        <partial name="CheapestMoviesPartial" model="@Model.CheapestMovies"></partial>   @* Cheapest Movies in table list (8 columns) *@
    </div>

    <div class="col-sm-6" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <h3 style="text-shadow: 5px 5px 10px red">Newest Movies:</h3>
        <partial name="NewestOldestMoviesPartial" model="@Model.NewestMovies"></partial>   @* Cheapest Movies in table list (8 columns) *@
    </div>


    <div class="col-sm-6" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <h3 style="text-shadow: 5px 5px 10px red">Oldest Movies:</h3>
        <partial name="NewestOldestMoviesPartial" model="@Model.OldestMovies"></partial>   @* Cheapest Movies in table list (8 columns) *@
    </div>
</div>




















