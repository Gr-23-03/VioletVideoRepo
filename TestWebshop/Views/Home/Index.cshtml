@model TestWebshop.Models.ViewModels.HomeIndexVM
@{
    ViewData["Title"] = "Home Page";

   
}


    <h1 class="display-4">Welcome</h1>



<div class="row">
    <div class="col-sm-12 col-md-4" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <a style="text-decoration: none; color: black" asp-controller="Movie" asp-action="PopularMovies"><h3 style="text-shadow: 5px 5px 10px red">Most popular Movies:</h3></a>
        <partial name="CarouselPartial" model="@Model.NewestMovies"></partial>   @* Most sold Movies in carousel (4 columns)*@
    </div>

    <div class="col-sm-12 col-md-8" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <a style="text-decoration: none; color: black" asp-controller="Movie" asp-action=""><h3 style="text-shadow: 5px 5px 10px red">Cheapest Movies:</h3></a>
        <partial name="CheapestMoviesPartial" model="@Model.CheapestMovies"></partial>   @* Cheapest Movies in table list (8 columns) *@
    </div>

    <div class="col-sm-12 col-md-6" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <a style="text-decoration: none; color: black" asp-controller="Movie" asp-action="LatestMovies"><h3 style="text-shadow: 5px 5px 10px red">Newest Movies:</h3></a>    
        <partial name="NewestOldestMoviesPartial" model="@Model.NewestMovies"></partial>   @* Newest Movies in table list (6 columns) *@
    </div>

    <div class="col-sm-12 col-md-6" style="box-shadow: 5px 5px 10px gray; margin: 0px; padding: 25px">
        <a style="text-decoration: none; color: black" asp-controller="Movie" asp-action="OldestMovies"><h3 style="text-shadow: 5px 5px 10px red">Oldest Movies:</h3></a>
        <partial name="NewestOldestMoviesPartial" model="@Model.OldestMovies"></partial>   @* Oldest Movies in table list (6 columns) *@
    </div>
</div>




















