    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Store</title>
    <link rel="stylesheet" href="site.css">
</head>
<body>


<header>
    <h1>VioletVideo</h1>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">New Releases</a>
    <a href="#">Classics</a>
    <a href="#">Contact</a>
</nav>

<main>
    <div class="video-card">
        <img src="path/to/mission-impossible-thumbnail.jpg" alt="Mission Impossible">
        <h3>Mission Impossible</h3>
        <p>Thrilling action with Tom Cruise.</p>
        <button>Buy Now</button>
    </div>

    <!-- Add more video cards for other popular films -->
    <div class="video-card">
        <img src="path/to/another-popular-film-thumbnail.jpg" alt="Popular Film Title">
        <h3>Popular Film Title</h3>
        <p>Description of the popular film.</p>
        <button>Buy Now</button>
    </div>

    @*    <!-- Repeat for more films... --> *@

</main>

<footer>
    <p>&copy; 2023 Online VioletVideo</p>
</footer>
